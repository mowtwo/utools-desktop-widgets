{
  "main": "index.html",
  "logo": "logo.png",
  "preload": "preload.js",
  "features": [
    {
      "code": "settings",
      "description": "晾衣绳设置：显示屏幕、显示方式、挂着的东西",
      "cmds": [
        "晾衣绳",
        "桌面挂件"
      ]
    },
    {
      "code": "peek",
      "description": "把晾衣绳拉下来看一眼（可绑定全局快捷键）",
      "cmds": [
        "拉下晾衣绳"
      ]
    },
    {
      "code": "ping",
      "description": "在光标位置发一个信号，可以顺手截一块图",
      "cmds": [
        "发信号"
      ],
      "mainHide": true
    },
    {
      "code": "rug-edit",
      "description": "拖动、缩放、旋转桌面地毯，完成后回到桌面图标上",
      "cmds": [
        "编辑地毯"
      ],
      "mainHide": true
    },
    {
      "code": "toggle",
      "description": "显示或隐藏晾衣绳",
      "cmds": [
        "显示/隐藏晾衣绳"
      ]
    },
    {
      "code": "capture",
      "description": "截图并挂到晾衣绳上",
      "cmds": [
        "截图挂到晾衣绳"
      ]
    },
    {
      "code": "hang",
      "description": "把图片、文字或文件挂到晾衣绳上",
      "cmds": [
        {
          "type": "img",
          "label": "挂到晾衣绳"
        },
        {
          "type": "over",
          "label": "挂到晾衣绳",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "files",
          "label": "挂到晾衣绳",
          "minLength": 1,
          "maxLength": 20
        }
      ]
    },
    {
      "code": "todo",
      "description": "加一条待办到待办卡里（每张最多 6 条）",
      "cmds": [
        "快速便签",
        {
          "type": "over",
          "label": "挂个待办",
          "minLength": 1,
          "maxLength": 30
        }
      ]
    }
  ],
  "tools": {
    "get_clothesline": {
      "description": "读取用户屏幕顶部晾衣绳上挂着的东西：图片、便签、文件 / 文件夹、待办卡（含每一条待办的 id 和完成状态）、挂件、空夹子。按从左到右的顺序返回。同时返回用户的屏幕列表（send_ping 可以指定屏幕）。取下东西或操作待办前先用它拿到 id。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image",
              "note",
              "file",
              "todo",
              "widget",
              "clip"
            ],
            "description": "只返回这一类；不填返回全部"
          }
        }
      }
    },
    "hang_on_clothesline": {
      "description": "把本地文件、文件夹或文字便签挂到用户屏幕顶部的晾衣绳上，方便用户随手拖用、双击打开。只记录路径，不复制、不移动文件。挂上后晾衣绳会滑下来给用户看一眼。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "文件或文件夹的绝对路径；文件夹会挂成可展开的衣架"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "文字便签，每条一张"
          }
        }
      }
    },
    "remove_from_clothesline": {
      "description": "从晾衣绳上取下东西（图片、便签、文件、待办卡、挂件、空夹子）。取下文件只是不再挂着，不会删除用户的文件。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "要取下的 id（来自 get_clothesline）"
          },
          "all": {
            "type": "boolean",
            "description": "为 true 时取下除挂件以外的全部东西"
          }
        }
      }
    },
    "add_todo": {
      "description": "在晾衣绳的待办卡上加一条待办（每条最多 30 字，每张卡片最多 6 条）。不指定卡片时加到用户设定的「快速添加」卡片；还没有卡片时自动新建一张。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "description": "待办内容，超过 30 字会被截断"
          },
          "card_id": {
            "type": "string",
            "description": "加到这张待办卡（id 来自 get_clothesline）"
          },
          "new_card": {
            "type": "boolean",
            "description": "为 true 时新建一张卡片放这条待办，并设为快速添加的目标"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "update_todo": {
      "description": "修改一条待办：标记完成 / 未完成，或改文字。不给 line_id 并且 done 为 true 时，把整张卡片的待办都标成已完成。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "card_id": {
            "type": "string",
            "description": "待办卡 id"
          },
          "line_id": {
            "type": "string",
            "description": "待办条目 id"
          },
          "done": {
            "type": "boolean",
            "description": "是否已完成"
          },
          "text": {
            "type": "string",
            "description": "新的文字，最多 30 字"
          }
        },
        "required": [
          "card_id"
        ]
      }
    },
    "remove_todo": {
      "description": "删除一条待办；不给 line_id 时取下整张待办卡。卡片的最后一条被删掉后，卡片也会一起取下。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "card_id": {
            "type": "string",
            "description": "待办卡 id"
          },
          "line_id": {
            "type": "string",
            "description": "待办条目 id"
          }
        },
        "required": [
          "card_id"
        ]
      }
    },
    "send_ping": {
      "description": "在用户屏幕上直接发一个游戏风格的信号（图标 + 动画，按用户设置可能有提示音），用来提醒或示意用户，例如任务完成发 done、需要用户处理发 help、出错发 danger。不弹轮盘、不截图，几秒后自动消失。按要表达的意思选择 signal：alert 注意 / danger 危险 / coming 在路上 / help 求助 / look 看这里 / question 问号 / done 完成 / idea 好主意 / ok 收到 / wait 等一下 / go 冲 / hot 着火了 / target 目标。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "signal": {
            "type": "string",
            "enum": [
              "alert",
              "danger",
              "coming",
              "help",
              "look",
              "question",
              "done",
              "idea",
              "ok",
              "wait",
              "go",
              "hot",
              "target"
            ],
            "description": "信号的意思：alert 注意 / danger 危险 / coming 在路上 / help 求助 / look 看这里 / question 问号 / done 完成 / idea 好主意 / ok 收到 / wait 等一下 / go 冲 / hot 着火了 / target 目标"
          },
          "position": {
            "type": "string",
            "enum": [
              "cursor",
              "center",
              "top",
              "bottom",
              "left",
              "right",
              "top-left",
              "top-right",
              "bottom-left",
              "bottom-right"
            ],
            "description": "在屏幕上的位置，默认 cursor（鼠标位置；目标屏幕上没有鼠标时为屏幕中间）"
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "精确位置：占目标屏幕宽度的比例，和 y 一起给时代替 position"
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "精确位置：占目标屏幕高度的比例"
          },
          "display": {
            "type": "string",
            "description": "发在哪块屏幕上：cursor（默认，鼠标所在的屏幕）、all（每块屏幕各发一个），或屏幕 id（get_clothesline 返回的 displays 里）"
          }
        },
        "required": [
          "signal"
        ]
      }
    }
  }
}
